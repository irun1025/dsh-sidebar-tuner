{
  "name": "dsh-sidebar-tuner",
  "version": "2.1.0",
  "type": "module",
  "description": "DSH 左侧栏优化：入口显隐、入口区与底部动作区两条横条拉伸。",
  "icon": "./icon.svg",
  "license": "MIT",
  "author": "irun1025",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "sidebar",
    "layout",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irun1025/dsh-sidebar-tuner.git"
  },
  "homepage": "https://github.com/irun1025/dsh-sidebar-tuner#readme",
  "bugs": {
    "url": "https://github.com/irun1025/dsh-sidebar-tuner/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
