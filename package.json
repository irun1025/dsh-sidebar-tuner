{
  "name": "@local/dsh-sidebar-studio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "DSH 左侧栏工作台：入口显隐、入口区与底部动作区两条横条拉伸。",
  "icon": "./icon.svg",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
